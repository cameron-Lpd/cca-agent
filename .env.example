# Hub connection
HUB_URL=https://your-hub.vercel.app
HUB_SECRET=your-shared-webhook-secret

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key

# Agent public URL (Railway assigns this — set after first deploy)
AGENT_CALLBACK_URL=https://your-agent.railway.app

# Timing (seconds)
POLL_INTERVAL=3600
APPROVAL_TIMEOUT=86400
